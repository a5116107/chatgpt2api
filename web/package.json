{
  "name": "next-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build && node scripts/verify-export.mjs",
    "start": "next start",
    "lint": "eslint src scripts tests playwright.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test navigation.spec.ts progress-polling.spec.ts export-artifacts.spec.ts",
    "test:e2e": "playwright test workspace.spec.ts video.spec.ts creative.spec.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "format": "prettier --write src scripts tests playwright.config.ts",
    "format:check": "prettier --check src scripts tests playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "immer": "^10.1.3",
    "localforage": "^1.10.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.38.0",
    "next": "16.2.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "react-medium-image-zoom": "^5.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@umijs/openapi": "^1.13.15",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier-plugin-organize-imports": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "prettier": "3.8.4"
  },
  "overrides": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9"
  }
}
